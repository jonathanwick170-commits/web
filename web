        const mobileLinks = document.querySelectorAll('.mobile-link');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Sample initial messages if empty
        const initialMessages = [
            {
                id: 1,
                name: "Pak Herman",
                phone: "081234567890",
                message: "Terima kasih mahasiswa Humanity Project sudah membantu kegiatan kerja bakti dan posyandu di Dusun I minggu lalu!",
                date: "12 Okt 2026, 14:30 WITA"
            },
            {
                id: 2,
                name: "Siti Rahma",
                phone: "082198765432",
                message: "Mohon jadwal bimbingan belajar anak-anak di Posko KKN diperbanyak harinya ya kak.",
                date: "14 Okt 2026, 09:15 WITA"
            }
        ];

        // Load messages from localStorage or set default
        function getMessages() {
            const saved = localStorage.getItem('kalukaluku_messages');
            if (saved) {
                return JSON.parse(saved);
            } else {
                localStorage.setItem('kalukaluku_messages', JSON.stringify(initialMessages));
                return initialMessages;
            }
        }

        function saveMessages(msgs) {
            localStorage.setItem('kalukaluku_messages', JSON.stringify(msgs));
            updateBadges();
        }

        function updateBadges() {
            const msgs = getMessages();
            const count = msgs.length;
            document.getElementById('badge-count').innerText = count;
            document.getElementById('badge-count-mobile').innerText = count;
            document.getElementById('badge-count-mobile-menu').innerText = count;
            document.getElementById('inbox-total-text').innerText = `Total: ${count} Pesan`;
        }

        // Form Submit Handler
        function handleFormSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('form-name').value;
            const phone = document.getElementById('form-phone').value;
            const msgText = document.getElementById('form-message-input').value;

            const now = new Date();
            const formattedDate = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) + `, ${now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })} WITA`;

            const newMessage = {
                id: Date.now(),
                name: name,
                phone: phone,
                message: msgText,
                date: formattedDate
            };

            const msgs = getMessages();
            msgs.unshift(newMessage);
            saveMessages(msgs);

            document.getElementById('contact-form').reset();
            const messageAlert = document.getElementById('form-message');
            messageAlert.classList.remove('hidden');
            
            setTimeout(() => {
                messageAlert.classList.add('hidden');
            }, 5000);
        }

        // Inbox Modal Controllers
        function openInboxModal() {
            renderInboxList();
            document.getElementById('inbox-modal').classList.remove('hidden');
        }

        function closeInboxModal() {
            document.getElementById('inbox-modal').classList.add('hidden');
        }

        function renderInboxList() {
            const container = document.getElementById('inbox-list');
            const msgs = getMessages();

            if (msgs.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-slate-400">
                        <i class="fa-regular fa-folder-open text-4xl mb-3 block"></i>
                        <p class="font-medium">Belum ada pesan atau aspirasi yang masuk.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = msgs.map(msg => `
                <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm relative group hover:border-brand-500 transition">
                    <div class="flex justify-between items-start mb-2">
                        <div>
                            <h4 class="font-bold text-slate-900 text-base">${escapeHtml(msg.name)}</h4>
                            <a href="https://wa.me/${escapeHtml(msg.phone.replace(/[^0-9]/g, ''))}" target="_blank" class="text-xs text-brand-600 hover:underline flex items-center gap-1 font-semibold">
                                <i class="fa-brands fa-whatsapp"></i> ${escapeHtml(msg.phone)}
                            </a>
                        </div>
                        <span class="text-[11px] text-slate-400 font-medium">${msg.date}</span>
                    </div>
                    <p class="text-slate-700 text-sm leading-relaxed mt-2 bg-slate-50 p-3 rounded-xl border border-slate-100">${escapeHtml(msg.message)}</p>
                    <div class="mt-3 flex justify-end">
                        <button onclick="deleteMessage(${msg.id})" class="text-xs text-rose-500 hover:text-rose-700 font-medium flex items-center gap-1 transition">
                            <i class="fa-regular fa-trash-can"></i> Hapus Pesan
                        </button>
                    </div>
                </div>
            `).join('');

            updateBadges();
        }

        function deleteMessage(id) {
            let msgs = getMessages();
            msgs = msgs.filter(m => m.id !== id);
            saveMessages(msgs);
            renderInboxList();
        }

        function clearAllMessages() {
            if (confirm('Apakah Anda yakin ingin menghapus semua pesan?')) {
                saveMessages([]);
                renderInboxList();
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }

        // Initialize badges on page load
        document.addEventListener('DOMContentLoaded', updateBadges);
    </script>
</body>
</html>
